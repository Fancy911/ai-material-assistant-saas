# Never commit a populated .env file.
DATABASE_URL="postgresql://ai_material:ai_material_dev_password@localhost:5432/ai_material?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
CANXIANG_BASE_URL="https://api.cxzja.cn"
CANXIANG_TOKEN=""
CANXIANG_TIMEOUT_MS="12000"
# Provider selection uses the database when RESOLVER_MODE is not "mock".
# GET endpoint for the paid-per-call Zhiling video parser.
ZHILING_API_BASE_URL="https://api.17zhiling.com/api/video/parse-video-url-times"
ZHILING_API_KEY=""
ZHILING_TIMEOUT_MS="12000"
RESOLVER_MODE="mock"
# Local development uses a deterministic miniapp session. Production must set AUTH_MODE="wechat".
AUTH_MODE="mock"
MEDIA_PROXY_SIGNING_KEY="replace-with-a-long-random-value"
MEDIA_PROXY_TTL_SECONDS="600"
MEDIA_PROXY_MAX_BYTES="52428800"
MEDIA_COMPAT_CACHE_DIR="/tmp/ai-material-compat"
MEDIA_COMPAT_CACHE_TTL_SECONDS="3600"
MEDIA_COMPAT_TIMEOUT_MS="120000"
MEDIA_COMPAT_PRESET="veryfast"
MEDIA_COMPAT_CRF="22"
APP_ORIGIN="http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176"
