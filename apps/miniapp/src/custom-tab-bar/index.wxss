.tabbar{position:fixed;z-index:99;right:0;bottom:0;left:0;display:flex;align-items:flex-start;justify-content:space-around;box-sizing:border-box;min-height:124rpx;padding:17rpx 30rpx calc(15rpx + env(safe-area-inset-bottom));border-top:1rpx solid #ede8f5;background:rgba(255,255,255,.97);box-shadow:0 -8rpx 32rpx rgba(56,38,99,.06)}
.tab{display:flex;min-width:112rpx;flex-direction:column;align-items:center;gap:7rpx;color:#797482;font-size:23rpx;font-weight:600;line-height:1}.icon-wrap{width:45rpx;height:45rpx}.icon-wrap image{width:100%;height:100%}.tab.active{color:#6f3ff5;font-weight:800}.tab.active .icon-wrap{transform:translateY(-1rpx)}
