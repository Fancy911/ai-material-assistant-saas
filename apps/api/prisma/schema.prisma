generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum AdminRole {
  TENANT_ADMIN
  SUPER_ADMIN
}
enum ResolveStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}
enum MediaKind {
  VIDEO
  IMAGE
}
enum RedeemStatus {
  UNUSED
  REDEEMED
  DISABLED
  EXPIRED
}
enum ProviderStatus {
  ENABLED
  DISABLED
}
enum TenantActivationStatus {
  UNUSED
  ACTIVATED
  REVOKED
}

model Tenant {
  id String @id @default(cuid())
  publicCode String @unique
  name String
  status TenantStatus @default(ACTIVE)
  expiresAt DateTime?
  quotaTotal Int @default(0)
  quotaRemaining Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  capabilities TenantCapability[]
  admins TenantAdmin[]
  users User[]
  pointsLedger PointsLedger[]
  quotaLedger QuotaLedger[]
  redeemCodes RedeemCode[]
  jobs ResolveJob[]
  settings TenantSetting?
  events Event[]
  audits AuditLog[]
  activationCodes TenantActivationCode[]
}

model TenantActivationCode {
  id String @id @default(cuid())
  tenantId String
  codeHash String @unique
  codeHint String
  status TenantActivationStatus @default(UNUSED)
  createdById String
  activatedById String?
  createdAt DateTime @default(now())
  activatedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, status, createdAt])
}

model TenantCapability {
  id String @id @default(cuid())
  tenantId String
  capability String
  enabled Boolean @default(true)
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  @@unique([tenantId, capability])
}

model TenantAdmin {
  id String @id @default(cuid())
  tenantId String?
  account String @unique
  passwordHash String
  role AdminRole
  createdAt DateTime @default(now())
  tenant Tenant? @relation(fields:[tenantId], references:[id], onDelete:Cascade)
}

model User {
  id String @id @default(cuid())
  tenantId String
  openid String
  pointsBalance Int @default(0)
  status UserStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  ledger PointsLedger[]
  jobs ResolveJob[]
  redeemedCodes RedeemCode[] @relation("redeemedCodes")
  events Event[]
  @@unique([tenantId, openid])
  @@index([tenantId, lastActiveAt])
}

model PointsLedger {
  id String @id @default(cuid())
  tenantId String
  userId String
  delta Int
  reason String
  refType String?
  refId String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([tenantId, userId, createdAt])
  @@unique([userId, reason, refId])
}

model QuotaLedger {
  id String @id @default(cuid())
  tenantId String
  delta Int
  reason String
  refId String?
  note String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  @@index([tenantId, createdAt])
  @@unique([tenantId, reason, refId])
}

model RedeemCode {
  id String @id @default(cuid())
  tenantId String
  codeHash String @unique
  codeHint String
  points Int
  status RedeemStatus @default(UNUSED)
  expiresAt DateTime?
  redeemedById String?
  redeemedAt DateTime?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  redeemedBy User? @relation("redeemedCodes", fields:[redeemedById], references:[id])
  @@index([tenantId, status])
}

model ResolveJob {
  id String @id @default(cuid())
  tenantId String
  userId String
  platform String
  urlHash String
  urlHost String
  status ResolveStatus @default(PENDING)
  mediaType String?
  title String?
  content String?
  errorCode String?
  provider String?
  idempotencyKey String?
  latencyMs Int?
  createdAt DateTime @default(now())
  completedAt DateTime?
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  media ResolveMedia[]
  providerCalls ProviderCall[]
  @@index([tenantId, userId, urlHash, createdAt])
  @@unique([userId, idempotencyKey])
}

model ResolveMedia {
  id String @id @default(cuid())
  jobId String
  type MediaKind
  sourceUrlEnc String
  metaJson Json?
  createdAt DateTime @default(now())
  job ResolveJob @relation(fields:[jobId], references:[id], onDelete:Cascade)
}

model Provider {
  id String @id @default(cuid())
  code String @unique
  name String
  status ProviderStatus @default(ENABLED)
  baseUrl String
  priority Int @default(1)
  costConfig Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  secret ProviderSecret?
  calls ProviderCall[]
}

model ProviderSecret {
  id String @id @default(cuid())
  providerId String @unique
  tokenCiphertext String
  last4 String
  updatedAt DateTime @updatedAt
  provider Provider @relation(fields:[providerId], references:[id], onDelete:Cascade)
}

model ProviderCall {
  id String @id @default(cuid())
  jobId String
  providerId String
  capability String
  status String
  upstreamStatus Int?
  latencyMs Int
  costEstimate Decimal @db.Decimal(12, 6)
  createdAt DateTime @default(now())
  job ResolveJob @relation(fields:[jobId], references:[id], onDelete:Cascade)
  provider Provider @relation(fields:[providerId], references:[id], onDelete:Cascade)
  @@index([providerId, createdAt])
}

model TenantSetting {
  id String @id @default(cuid())
  tenantId String @unique
  miniappName String @default("AI素材助手")
  notice String?
  appid String?
  appsecretCiphertext String?
  initialPoints Int @default(10)
  pointCost Int @default(1)
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
}

model Event {
  id String @id @default(cuid())
  tenantId String
  userId String?
  eventName String
  metaJson Json?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields:[tenantId], references:[id], onDelete:Cascade)
  user User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([tenantId, eventName, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  tenantId String?
  actorId String
  action String
  targetType String
  targetId String?
  metaJson Json?
  createdAt DateTime @default(now())
  tenant Tenant? @relation(fields:[tenantId], references:[id], onDelete:SetNull)
}
